{
  "expo": {
    "name": "Rent Manager",
    "slug": "rent-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0066CC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rentmanager.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0066CC",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.rentmanager.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Rent Manager to access your photos for uploading documents.",
          "cameraPermission": "Allow Rent Manager to access your camera for taking photos of documents."
        }
      ]
    ],
    "scheme": "rentmanager",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "your-project-id"
      }
    },
    "owner": ""
  }
}
